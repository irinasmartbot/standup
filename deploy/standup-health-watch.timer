[Unit]
Description=Run StandUp health check every 3 minutes
# На VPS фактически стоит cron пользователя standup (см. deploy-dev.yml).
# Этот timer — запасной вариант, если ставить system unit от root.

[Timer]
OnBootSec=2min
OnUnitActiveSec=3min
AccuracySec=30s
Unit=standup-health-watch.service

[Install]
WantedBy=timers.target
