BOT_TOKEN=your_telegram_bot_token_here
CSV_URL=your_google_sheets_csv_url_here
BEST_CSV_URL=your_best_google_sheets_csv_url_here
HITLOTO_CSV_URL=your_hitloto_google_sheets_csv_url_here
MANAGER_LINK=https://t.me/your_manager_username
CHANNEL_LINK=https://t.me/your_channel_username
CHANNEL_USERNAME=MoscowStandupShow
MANAGER_PHONE=your_manager_phone_here
DB_PATH=bookings.db
DATABASE_URL=postgresql://standup_user:your_password@localhost:5432/standup_db
EVENTS_SOURCE=sheets
BOOKINGS_SOURCE=sqlite

# Daily Postgres backup → Beget Object Storage (optional; local dump always runs)
# Keys only on VPS .env, never commit.
S3_BACKUP_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_BACKUP_BUCKET=7c6dd6e13340-standup-db-backups
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
S3_BACKUP_REGION=ru1

TICKET_TEMPLATE=photo_2023-06-26_15-06-46.jpg
# тестовый чат модерации (позже можно заменить на боевой)
MODERATION_CHAT_ID=-1004375005536
HELP_CHAT_ID=-1002342467016
# Техчат: алерты о падении ботов/админки и необработанных ошибках
# Узнать id: добавить боевого бота в чат → /techid (только TEST_ADMIN_IDS)
TECH_CHAT_ID=
AFISHA_REVIEW_URL=https://afisha.yandex.ru/moscow/standup/stand-up-ot-komikov-iz-tv-i-youtube-proektov?source=rubric
ROZYGRYSH_STICKER_FILE_ID=
# 1 = не проверять подписку (временно для теста). Когда бот админ канала — поставить 0
ROZYGRYSH_SKIP_SUB_CHECK=1
# При ROZYGRYSH_SKIP_SUB_CHECK=1 команда /reset_rozygrysh доступна всем в личке.
# Когда skip=0 — только эти telegram id (через запятую):
TEST_ADMIN_IDS=
SITE_URL=https://MoscowStandUpshow.ru

# Yandex Metrica offline conversions (optional)
# Token is stored only on VPS .env, never commit it.
YANDEX_METRIKA_COUNTER_ID=88707048
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_BOOKING_CREATED_TARGET=booking_created

# Web admin panel for bookings
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Manager: only «Мероприятия» (edit schedule)
ADMIN_TOKEN=
# Client: bookings / users / analytics / events (no DB, no ticket resend)
ADMIN_CLIENT_TOKEN=
# Owner: full admin + ticket resend + "База"
ADMIN_OWNER_TOKEN=

# VK bot + public entry landings (standup-admin serves /vk/*)
VK_ENABLED=1
VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_MANAGER_LINK=https://vk.com/
VK_COMMUNITY_LINK=https://vk.com/
# Лендинги go…/vk/*: виджет allow-messages + VK ID One Tap + POST /vk/entry
# APP ID из кабинета VK ID (Web), базовый домен go.moscowstandupshow.ru
VK_OPENAPI_APP_ID=

